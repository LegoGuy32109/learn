TURSO_API_KEY=
TURSO_ORG_SLUG=
TURSO_DB_URL=
TURSO_DB_TOKEN=
LEARN_OWNER_TOKEN=
# 32 random bytes in base64url. deno task db:owner writes one. Browser sessions are signed with it.
LEARN_SESSION_KEY=
# Pinned WebAuthn relying party for a deployed origin. Leave both unset to allow plain localhost only.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# Where deno task invite:mint sends its request. Defaults to http://localhost:8000.
LEARN_BASE_URL=
