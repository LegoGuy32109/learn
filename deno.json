{
  "lint": {
    "plugins": ["./lint/plugin.ts"]
  },
  "fmt": {
    "include": [
      "main.ts",
      "src/",
      "scripts/",
      "tests/",
      "lint/",
      "types/",
      "public/css/",
      "public/js/"
    ],
    "exclude": ["**/*.md", "public/tools/", "public/plugin/", "docs/reference/"]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task audit:contract:local",
    "hooks": "git config core.hooksPath .githooks",
    "dev": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN,PORT,LEARN_SESSION_KEY,WEBAUTHN_RP_ID,WEBAUTHN_ORIGINS,DENO_DEPLOY_BUILD_ID --allow-net --allow-read --watch main.ts",
    "check": "deno check main.ts src/app.ts public/js/*.js src/shared/**/*.js src/client/identity/*.js src/client/learning/*.js src/client/library/*.js src/client/storage/*.js src/client/ui/*.js src/client/pwa/register.js src/client/pwa/sw-routing.js src/client/pwa/update-policy.js src/server/**/*.ts scripts/*.ts && deno check --config deno.worker.json src/client/pwa/sw.js && deno check tests",
    "test": "deno test --allow-read --allow-write --allow-run=deno,git,claude,which --allow-net=127.0.0.1 --allow-env=LEARN_TOKEN,LEARN_BASE_URL tests/shared tests/client tests/server tests/lint",
    "e2e": "deno test --allow-all tests/e2e",
    "audit:phone": "deno test --allow-all tests/audit",
    "audit:prod": "deno test --allow-all tests/audit-prod",
    "audit:golden": "deno test --allow-all tests/audit-golden",
    "audit:contract": "deno test --allow-read --allow-write --allow-run=deno --allow-net --allow-env=LEARN_TOKEN,LEARN_OWNER_TOKEN,LEARN_BASE_URL tests/audit/contract-attacks/contract_attacks_test.ts",
    "audit:contract:local": "LEARN_BASE_URL=local deno test --allow-read --allow-write --allow-run=deno --allow-net --allow-env=LEARN_TOKEN,LEARN_OWNER_TOKEN,LEARN_BASE_URL tests/audit/contract-attacks/contract_attacks_test.ts",
    "db:provision": "deno run --env-file=.env --allow-env=TURSO_API_KEY,TURSO_ORG_SLUG --allow-net --allow-read --allow-write scripts/provision-databases.ts",
    "db:migrate": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/migrate.ts",
    "db:owner": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read --allow-write scripts/bootstrap-owner.ts",
    "db:seed": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/seed-demo.ts",
    "token:mint": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/tokens.ts mint",
    "token:list": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/tokens.ts list",
    "token:revoke": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/tokens.ts revoke",
    "token:rotate": "deno run --env-file=.env --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/tokens.ts rotate",
    "tools:generate": "deno run --allow-read --allow-write scripts/generate-tools.ts",
    "plugin:generate": "deno run --allow-read --allow-write --allow-env=LEARN_PUBLIC_ORIGIN scripts/generate-plugin.ts",
    "test:db": "deno test --env-file=.env --allow-env --allow-net --allow-read --allow-run tests/db",
    "test:sync": "deno test --env-file=.env --allow-all tests/db-sync",
    "db:provision:prod": "deno run --env-file=.env --allow-env=TURSO_API_KEY,TURSO_ORG_SLUG --allow-net --allow-read --allow-write scripts/provision-production.ts",
    "db:migrate:prod": "deno run --env-file=.env.prod --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/migrate.ts",
    "db:owner:prod": "deno run --env-file=.env.prod --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read --allow-write scripts/bootstrap-owner.ts --env-path=.env.prod",
    "db:seed:prod": "deno run --env-file=.env.prod --allow-env=TURSO_DB_URL,TURSO_DB_TOKEN --allow-net --allow-read scripts/seed-demo.ts",
    "deploy:env": "deno run --env-file=.env -A --no-lock scripts/set-deploy-env.ts Production --from=.env.prod && deno run --env-file=.env -A --no-lock scripts/set-deploy-env.ts Preview --from=.env.dev && deno run --env-file=.env -A --no-lock scripts/set-deploy-env.ts Local --from=.env",
    "deploy": "deno run --env-file=.env --allow-env --allow-run=deno --allow-read --allow-write=deno.json --allow-net scripts/deploy.ts",
    "smoke:prod": "deno run --env-file=.env.prod --allow-env=LEARN_BASE_URL,LEARN_OWNER_TOKEN --allow-net --allow-read scripts/smoke-prod.ts",
    "invite:mint": "deno run --env-file=.env --allow-env=LEARN_OWNER_TOKEN,LEARN_BASE_URL --allow-net scripts/invite.ts",
    "invite:mint:prod": "deno run --env-file=.env.prod --allow-env=LEARN_OWNER_TOKEN,LEARN_BASE_URL --allow-net scripts/invite.ts --base-url=https://learn.joshhale.me"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "json-schema-to-ts": "npm:json-schema-to-ts@3.1.1",
    "@std/dotenv/parse": "jsr:@std/dotenv@0.225.8/parse",
    "@playwright/test": "npm:@playwright/test@1.63.0",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@13.3.2",
    "@tursodatabase/serverless/compat": "npm:@tursodatabase/serverless@1.4.0/compat",
    "ajv/2020": "npm:ajv@8.17.1/dist/2020.js",
    "ajv-formats": "npm:ajv-formats@3.0.1"
  },
  "compilerOptions": { "lib": ["deno.ns", "dom", "dom.iterable"], "noImplicitAny": true,
    "types": ["./types/strict-json.d.ts"] },
  "deploy": {
    "org": "legoguy32109",
    "app": "learn-joshhale",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./main.ts"
    },
    "exclude": [
      ".env",
      ".env.*",
      "tests",
      "docs",
      "issues",
      "briefs",
      "playwright-report",
      "test-results",
      "backups"
    ]
  }
}
